# ====================================================================
# Agri-Connect Environment Configuration
# ====================================================================

# Server Port (Avoiding macOS AirPlay Receiver port 5000)
PORT=5050

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.zvmhp4v.mongodb.net/agri_connect?retryWrites=true&w=majority

# Client API URL
VITE_API_BASE_URL=http://localhost:5050

# [OPTIONAL] OpenAI API Key for Live Universal AI Chatbot Completion:
# Kisan AI will use this API key for open-ended conversational intelligence (GPT-4o-mini).
# If left blank or not configured, Kisan AI automatically runs in high-performance
# built-in offline mode covering agriculture, science, math, coding, history, and daily life.
VITE_OPENAI_API_KEY=
